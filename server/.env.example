# ─── Runtime ──────────────────────────────────────────────────────────────
# development | production | test
NODE_ENV=development
# Port for the local HTTP server (ignored on Vercel)
PORT=5000

# ─── CORS / Cookies ───────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API with credentials
CLIENT_ORIGINS=http://localhost:5173
# Public URL of the frontend (used in email links)
CLIENT_URL=http://localhost:5173
# lax | strict | none — use "none" when client and API live on different sites
# (e.g. two *.vercel.app domains). "none" automatically forces Secure cookies.
COOKIE_SAME_SITE=lax

# ─── Database ─────────────────────────────────────────────────────────────
# MongoDB connection string (MongoDB Atlas recommended for production)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=foundit

# ─── Authentication ───────────────────────────────────────────────────────
# Long random string, e.g. `openssl rand -base64 48`
JWT_SECRET=replace-with-a-long-random-secret
# Session lifetime (jsonwebtoken format: 7d, 12h, 30m, ...)
JWT_EXPIRES_IN=7d

# ─── Caching ──────────────────────────────────────────────────────────────
# Optional. Redis connection URL (Upstash: rediss://default:<token>@<host>:6379).
# When omitted, an in-process memory cache is used.
REDIS_URL=
# Default TTL (seconds) for cached public item listings
CACHE_TTL_SECONDS=60

# ─── Email (SMTP) ─────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# For Gmail, use an App Password (https://myaccount.google.com/apppasswords)
SMTP_PASS=
SENDER_EMAIL=FoundIt <no-reply@example.com>

# ─── Media storage ────────────────────────────────────────────────────────
# Optional locally, REQUIRED on Vercel/serverless (the filesystem is ephemeral).
# When omitted, images are written to ./uploads and served from /uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=foundit/items
