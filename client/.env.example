# Base URL of the FoundIt API, including the /api prefix.
#  - Local development: leave as "/api" — Vite proxies it to VITE_DEV_PROXY_TARGET.
#  - Production: the deployed API, e.g. https://foundit-api.vercel.app/api
#    (or "/api" if you add a Vercel rewrite that proxies /api to the backend).
VITE_API_URL=/api

# Backend address used by the Vite dev server proxy (development only).
VITE_DEV_PROXY_TARGET=http://localhost:5000
